{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "strict": true,
        "noEmit": true,
        "lib": ["ES2022", "DOM"],
        "types": ["vitest/globals", "node"],
        "skipLibCheck": true
    },
    "include": [
        "resources/js/**/*.ts",
        "resources/js/**/*.vue",
        "tests/frontend/**/*.ts",
        "vitest.config.ts"
    ]
}
